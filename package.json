{
  "name": "gajae-app",
  "private": true,
  "version": "2.0.0-beta.9",
  "desktopVersion": "0.2.3",
  "productName": "Gajae Code App",
  "description": "A self-hosted web and desktop interface for GJC",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "gajae-app": "dist-server/server/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "public/api-docs.html",
    "dist/",
    "dist-server/",
    "dist-native/",
    "scripts/"
  ],
  "homepage": "https://github.com/devswha/gajae-code-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devswha/gajae-code-app.git"
  },
  "bugs": {
    "url": "https://github.com/devswha/gajae-code-app/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "dev:isolated": "node scripts/start-isolated-dev.mjs",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.js",
    "preserver:dev": "npm run fill:runtime-manifest && npm run build:core:dev",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.js",
    "preserver:dev-watch": "npm run fill:runtime-manifest && npm run build:core:dev",
    "client": "vite",
    "desktop": "node src-tauri/scripts/tauri.mjs dev",
    "desktop:dev": "node src-tauri/scripts/tauri.mjs dev",
    "server:bundle": "npm run build && node scripts/release/build-server-bundle.js",
    "server:payload:macos": "node scripts/fetch-bun.mjs && npm run build && node scripts/release/build-macos-server-payload.mjs",
    "server:payload:linux": "node scripts/fetch-bun.mjs && npm run build && node scripts/release/build-linux-server-payload.mjs",
    "desktop:build:linux": "node scripts/release/build-linux-desktop.mjs",
    "tauri": "node src-tauri/scripts/tauri.mjs",
    "desktop:sign:macos": "node scripts/release/finalize-macos-app.mjs",
    "desktop:dmg:macos": "node scripts/release/make-macos-dmg.mjs",
    "desktop:artifacts:macos": "node scripts/release/make-macos-updater.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:core",
    "build:client": "vite build",
    "build:core": "node scripts/build-rust-core.mjs --release",
    "build:core:dev": "node scripts/build-rust-core.mjs",
    "prebuild:server": "node scripts/fill-runtime-manifest.mjs && node scripts/generate-command-surface.mjs && node -e \"require('node:fs').rmSync('dist-server', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "check:identity": "node scripts/check-identity.mjs",
    "audit": "node scripts/check-audit.mjs",
    "audit:react": "npx react-doctor@latest",
    "check:core": "cargo fmt --manifest-path native/gajae-core/Cargo.toml -- --check && cargo clippy --locked --manifest-path native/gajae-core/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path native/gajae-core/Cargo.toml",
    "fill:runtime-manifest": "node scripts/fill-runtime-manifest.mjs",
    "generate:command-surface": "node scripts/generate-command-surface.mjs",
    "icon:generate": "node scripts/generate-app-icon.mjs --write",
    "icon:preview": "node scripts/generate-app-icon.mjs --preview",
    "test": "node scripts/run-tests.mjs",
    "smoke:packaged-server": "node scripts/release/smoke-packaged-server.mjs",
    "pretest": "npm run build:core:dev",
    "test:e2e:gjc": "TSX_TSCONFIG_PATH=server/tsconfig.json node --import tsx --test --test-concurrency=1 server/e2e/gjc-slice4.browser.e2e.ts server/e2e/gjc-slice4.wire.e2e.ts",
    "test:e2e:browser": "TSX_TSCONFIG_PATH=server/tsconfig.json node --import tsx --test --test-concurrency=1 server/e2e/browser-sidecar.e2e.ts",
    "browser:debug": "node scripts/browser-debug-client.mjs",
    "poc:opencodex:cua": "node scripts/check-opencodex-cua-poc.mjs",
    "lint": "eslint src/ server/ shared/ scripts/ vite.config.js",
    "lint:fix": "eslint src/ server/ shared/ scripts/ vite.config.js --fix",
    "verify": "npm run audit && npm run check:licenses && npm run check:notices && npm run typecheck && npm run check:core && npm test && npm run lint && npm run check:identity && npm run build",
    "start": "npm run build && npm run server",
    "postinstall": "node scripts/fix-node-pty.js",
    "prepare": "husky",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "check:notices": "node scripts/generate-third-party-notices.mjs --check",
    "measure:derivation": "node scripts/measure-upstream-derivation.mjs"
  },
  "build": {
    "appId": "app.gajae.desktop",
    "productName": "Gajae Code App",
    "executableName": "gajae-app",
    "artifactName": "gajae-app-desktop-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Gajae Code App",
        "schemes": [
          "gajae-app"
        ]
      }
    ],
    "mac": {
      "extendInfo": {
        "CFBundleName": "Gajae Code App",
        "CFBundleDisplayName": "Gajae Code App",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Gajae Code App",
            "CFBundleURLSchemes": [
              "gajae-app"
            ]
          }
        ]
      }
    }
  },
  "keywords": [
    "gajae-app",
    "gajae-code",
    "agent-interface",
    "self-hosted",
    "gjc",
    "desktop-agent",
    "tauri-app"
  ],
  "author": "devswha and Gajae Code App contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "overrides": {
    "ip-address": "^10.5.0",
    "release-it": {
      "undici": "7.29.0"
    }
  },
  "dependencies": {
    "@gajae-code/coding-agent": "0.16.4",
    "@octokit/rest": "^22.0.0",
    "@puppeteer/browsers": "^2.13.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.102.6",
    "@vscode/ripgrep": "^1.17.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-pty": "^1.2.0-beta.12",
    "pretendard": "^1.3.9",
    "puppeteer-core": "^24.43.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.14.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.3",
    "@happy-dom/global-registrator": "^20.11.6",
    "@release-it/conventional-changelog": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.25",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "postcss": "^8.4.32",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "release-it": "^20.2.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "server/**/*.{js,ts}": "eslint",
    "{shared,scripts}/**/*.{js,mjs,cjs,ts}": "eslint"
  }
}
